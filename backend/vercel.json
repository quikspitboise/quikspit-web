{
  "framework": null,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && corepack pnpm install --frozen-lockfile",
  "buildCommand": "cd .. && corepack pnpm --filter backend build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/serverless"
    },
    {
      "source": "/",
      "destination": "/api/serverless"
    }
  ],
  "functions": {
    "api/serverless.js": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    }
  }
}
