{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/serverless" }
  ],
  "functions": {
    "api/serverless.ts": {
      "runtime": "@vercel/node@5",
      "includeFiles": "dist/**"
    }
  }
}
