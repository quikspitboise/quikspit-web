{
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/serverless" }
  ],
  "functions": {
    "api/serverless.ts": {
      "includeFiles": "dist/**"
    }
  }
}
