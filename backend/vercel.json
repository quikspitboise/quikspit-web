{
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/serverless"
    },
    {
      "source": "/",
      "destination": "/api/serverless"
    }
  ],
  "functions": {
    "api/serverless.js": {
      "includeFiles": "dist/**"
    }
  }
}
