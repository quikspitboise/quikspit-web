# ──────────────────────────────────────────
# QuikSpit Backend — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── General ──────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Enable only on long-lived hosts with a writable filesystem
ENABLE_FILE_LOGGING=false

# ── Database (PostgreSQL) ────────────────
# Use either DATABASE_URL or the individual DB_* values below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# Local PostgreSQL uses no TLS. Use true for managed/persistent deployments.
DB_SSL=false
# TLS always verifies certificates. System trust roots are used by default.
DB_SSL_CA=
DB_SSL_CA_FILE=
# Persistent environments use migration:run. Synchronization is local-only,
# and additionally requires NODE_ENV=development, DB_DISPOSABLE=true and a loopback host.
DB_SYNCHRONIZE=false
DB_DISPOSABLE=false

# ── Cloudinary ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Clerk Auth ───────────────────────────
# Development: pk_test_... / sk_test_...
# Production:  pk_live_... / sk_live_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ADMIN_USER_IDS=user_xxx,user_yyy
# Development: http://localhost:3000
# Production:  https://quikspitboise.com
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# ── Stripe ───────────────────────────────
# Development: sk_test_...
# Production:  sk_live_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Twilio (SMS) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── PostHog (Analytics) ─────────────────
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Security / CORS ─────────────────────
CSRF_SECRET=
ENABLE_CSRF=false
ENFORCE_HTTPS=false
CANONICAL_API_ORIGIN=
# Comma-separated trusted ingress IPs/CIDRs. Empty means no trusted proxy.
# Never use trust-all or a hop count. The edge must replace forwarded headers.
TRUST_PROXY=
# Development: http://localhost:3000
# Production:  https://quikspitboise.com
ALLOWED_ORIGINS=http://localhost:3000

# Google reviews share a database cache and refresh lease across instances.
# Set the place ID explicitly so a cold refresh needs only the details request.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
