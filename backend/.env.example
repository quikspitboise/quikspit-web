# ──────────────────────────────────────────
# QuikSpit Backend — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── General ──────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── Database (PostgreSQL) ────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# ── Cloudinary ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Clerk Auth ───────────────────────────
# Development: pk_test_... / sk_test_...
# Production:  pk_live_... / sk_live_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ADMIN_USER_IDS=user_xxx,user_yyy
# Development: http://localhost:3000
# Production:  https://quikspitboise.com
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# ── Stripe ───────────────────────────────
# Development: sk_test_...
# Production:  sk_live_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Twilio (SMS) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── PostHog (Analytics) ─────────────────
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Security / CORS ─────────────────────
CSRF_SECRET=
ENABLE_CSRF=false
ENFORCE_HTTPS=false
# Development: http://localhost:3000
# Production:  https://quikspitboise.com
ALLOWED_ORIGINS=http://localhost:3000
