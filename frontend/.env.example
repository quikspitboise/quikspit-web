# ──────────────────────────────────────────
# QuikSpit Frontend — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local

# ── Backend API ──────────────────────────
# Development: http://localhost:3001
# Production:  https://your-backend.vercel.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── Clerk Auth ───────────────────────────
# Development: pk_test_... / sk_test_...
# Production:  pk_live_... / sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ADMIN_USER_IDS=user_xxx,user_yyy

# ── Cloudinary ───────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only, used by /api/admin/gallery/upload-signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Environment ──────────────────────────
# Development: development
# Production:  production
NEXT_PUBLIC_ENV=development

# ── PostHog (Analytics) ─────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Cal.com (Booking) ───────────────────
NEXT_PUBLIC_CAL_USERNAME=quikspitboise

# ── Site URL ─────────────────────────────
NEXT_PUBLIC_SITE_URL=https://quikspitboise.com
