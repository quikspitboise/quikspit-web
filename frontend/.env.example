# ──────────────────────────────────────────
# QuikSpit Frontend — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local

# ── Backend API ──────────────────────────
# Both http://localhost:3001 and http://localhost:3001/api are accepted.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── Clerk Auth ───────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ADMIN_USER_IDS=user_xxx,user_yyy

# ── Cloudinary ───────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Environment ──────────────────────────
NEXT_PUBLIC_ENV=development

# ── PostHog (Analytics) ─────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Cal.com (Booking) ───────────────────
NEXT_PUBLIC_CAL_USERNAME=quikspitboise

# ── Site URL ─────────────────────────────
NEXT_PUBLIC_SITE_URL=https://quikspitboise.com
